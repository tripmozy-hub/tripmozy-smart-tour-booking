# ============================================================================
# TripMozy Smart Tour Booking Marketplace - Environment Configuration
# ============================================================================

# Application Port (defaults to 8080)
PORT=8080

# Gmail SMTP for Live Email Notifications (Active)
GMAIL_USER=tripmozy@gmail.com
GMAIL_APP_PASSWORD=hiul rjbe mftg novo

# Fast2SMS Live Indian Telecom Gateway API Key
# To deliver SMS directly to physical Indian mobile phones (Jio/Airtel/Vi):
# 1. Sign up free at https://www.fast2sms.com/
# 2. Go to "Dev API" tab and copy your API authorization key
# 3. Paste it here:
FAST2SMS_API_KEY=

# Twilio SMS Gateway (Alternative international carrier)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Meta WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=tripmozy_dev_secret
