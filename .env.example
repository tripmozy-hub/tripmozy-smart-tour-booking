# ============================================================================
# TripMozy Smart Tour Booking Marketplace - Environment Configuration
# ============================================================================

# Application Port (defaults to 8080)
PORT=8080

# Gmail SMTP for Live Email Notifications (Active)
GMAIL_USER=tripmozy@gmail.com
GMAIL_APP_PASSWORD=hiul rjbe mftg novo

# Live Indian Telecom SMS Gateway API Keys
# To send physical cellular SMS directly to Indian mobile numbers (Jio/Airtel/Vi):
# Option A: Fast2SMS (https://www.fast2sms.com/ -> Dev API)
FAST2SMS_API_KEY=

# Option B: 2Factor.in (https://2factor.in/)
TWO_FACTOR_API_KEY=

# Option C: MSG91 (https://msg91.com/)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Option D: Twilio SMS (International & India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option E: Custom Webhook SMS Gateway
SMS_GATEWAY_URL=

# Meta WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=tripmozy_dev_secret
